# Telegram 登录凭证
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 机器人账号的 Telegram 用户名，不带 @
# 例如你的账号是 @abc123，就填 abc123
MY_USERNAME=

# 管理员自己的 Telegram 数字 ID
# 例如 123456789
OWNER_ID=

# 你的 AI 接口（任何 OpenAI 兼容接口都行）
# 以 DeepSeek 为例：
#   AI_API_BASE=https://api.deepseek.com
#   AI_API_MODEL=deepseek-chat
AI_API_KEY=
AI_API_BASE=
AI_API_MODEL=

# pm2 进程名
# 你用 pm2 启动脚本时起的名字，例如下面这条命令里的 mybot：
#   pm2 start index.js --name mybot
# 填上它，机器人里的「重启」命令才能生效。不填则「重启」命令无效，其他功能不受影响。
PM2_NAME=

# 搜索接口（可选，不填则联网搜索不可用，其他功能不受影响）
# 接口一地址，例如 https://google.serper.dev/search
SEARCH_API_BASE=
# 接口二地址，例如 https://api.tavily.com/search
SEARCH_API_BASE_2=
# 两个接口共用一个 key
SEARCH_API_KEY=
