# Telegram 登录凭证
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 机器人账号的 Telegram 用户名，不带 @
# 例如你的账号是 @abc123，就填 abc123
MY_USERNAME=

# 管理员自己的 Telegram 数字 ID
# 例如 123456789
OWNER_ID=

# 你的 AI 接口
CUSTOM_API_KEY=
CUSTOM_API_BASE=
CUSTOM_API_MODEL=

# pm2 进程名
# 这是你用 pm2 启动脚本时起的名字，例如下面这条命令里的 mybot：
#   pm2 start index.js --name mybot
# 填上它，机器人里的「重启」命令才能生效。不填则「重启」命令无效，其他功能不受影响。
PM2_NAME=

# 搜索 Key（可选）
SERPER_API_KEY=
TAVILY_API_KEY=
